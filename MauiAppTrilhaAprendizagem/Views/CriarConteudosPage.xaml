<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppTrilhaAprendizagem.Views.CriarConteudosPage"
             Title="Criar Conteúdos">

    <VerticalStackLayout Spacing="20" Padding="30">
        <Label Text="Estruturação de Novas Atividades" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
        <Entry Placeholder="Título da Atividade (ex: Contagem de Objetos)" />
        <Entry Placeholder="Nível de Dificuldade (Básico, Intermediário)" />
        <Button Text="Cadastrar Conteúdo" BackgroundColor="Purple" TextColor="White" />
    </VerticalStackLayout>
</ContentPage>