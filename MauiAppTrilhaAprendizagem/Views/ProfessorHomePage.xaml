<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppTrilhaAprendizagem.Views.ProfessorHomePage"
             Title="Área do Professor">

    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Bem-vindo, Professor!"
               FontSize="22"
               HorizontalOptions="Center"
               TextColor="DarkGreen"/>

        <Button Text="📚 Gerenciar Trilhas"
                HorizontalOptions="Fill"
                Clicked="OnGerenciarTrilhasClicked"/>

        <Button Text="👩‍🎓 Acompanhar Alunos"
                HorizontalOptions="Fill"
                Clicked="OnAcompanharAlunosClicked"/>

        <Button Text="📊 Relatórios"
                HorizontalOptions="Fill"
                Clicked="OnRelatoriosClicked"/>

        <Button Text="Sair"
                BackgroundColor="#0078D7"
                TextColor="White"
                Clicked="OnLogoutClicked"/>
    </VerticalStackLayout>
</ContentPage>
