<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppTrilhaAprendizagem.Views.ProfessorHomePage"
             Title="Área do Professor">

    <VerticalStackLayout Spacing="25" Padding="30" VerticalOptions="Center">

        <!-- Título de Boas-vindas -->
        <Label Text="Bem-vindo, Professor!"
               FontSize="24"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               TextColor="DarkGreen" />

        <!-- Botões de Ações do Professor -->
        <Button Text="📚 Gerenciar Trilhas"
                Clicked="OnGerenciarTrilhasClicked"
                BackgroundColor="White"
                TextColor="Black"
                BorderColor="LightGray"
                BorderWidth="1" />

        <Button Text="👨‍🎓 Acompanhar Alunos"
                Clicked="OnAcompanharAlunosClicked"
                BackgroundColor="White"
                TextColor="Black"
                BorderColor="LightGray"
                BorderWidth="1" />

        <Button Text="📊 Relatórios"
                Clicked="OnRelatoriosClicked"
                BackgroundColor="White"
                TextColor="Black"
                BorderColor="LightGray"
                BorderWidth="1" />

        <!-- Botão de Sair / Logout -->
        <Button Text="Sair"
                Clicked="OnSairClicked"
                BackgroundColor="#007ACC"
                TextColor="White"
                FontAttributes="Bold" />

    </VerticalStackLayout>
</ContentPage>