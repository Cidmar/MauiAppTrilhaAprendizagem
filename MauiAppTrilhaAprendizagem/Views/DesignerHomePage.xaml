<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppTrilhaAprendizagem.Views.DesignerHomePage"
             Title="Área do Designer Pedagógico">

    <VerticalStackLayout Spacing="25" Padding="30" VerticalOptions="Center">

        <Label Text="Bem-vindo, Designer Pedagógico!"
               FontSize="22"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               TextColor="Purple" />

        <Button Text="✏️ Criar Conteúdos"
                Clicked="OnCriarConteudosClicked"
                BackgroundColor="White"
                TextColor="Black"
                BorderColor="LightGray"
                BorderWidth="1" />

        <Button Text="🛠️ Editar Trilhas"
                Clicked="OnEditarTrilhasClicked"
                BackgroundColor="White"
                TextColor="Black"
                BorderColor="LightGray"
                BorderWidth="1" />

        <Button Text="🤝 Colaborar com Professores"
                Clicked="OnColaborarClicked"
                BackgroundColor="White"
                TextColor="Black"
                BorderColor="LightGray"
                BorderWidth="1" />

        <Button Text="Sair"
                Clicked="OnSairClicked"
                BackgroundColor="#007ACC"
                TextColor="White"
                FontAttributes="Bold" />

    </VerticalStackLayout>
</ContentPage>