<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppTrilhaAprendizagem.Views.DesignerHomePage"
             Title="Área do Designer Pedagógico">

    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Bem-vindo, Designer Pedagógico!"
               FontSize="22"
               HorizontalOptions="Center"
               TextColor="Purple"/>

        <Button Text="✏️ Criar Conteúdos"
                HorizontalOptions="Fill"
                Clicked="OnCriarConteudosClicked"/>

        <Button Text="🛠️ Editar Trilhas"
                HorizontalOptions="Fill"
                Clicked="OnEditarTrilhasClicked"/>

        <Button Text="🤝 Colaborar com Professores"
                HorizontalOptions="Fill"
                Clicked="OnColaborarClicked"/>

        <Button Text="Sair"
                BackgroundColor="#0078D7"
                TextColor="White"
                Clicked="OnLogoutClicked"/>
    </VerticalStackLayout>
</ContentPage>
