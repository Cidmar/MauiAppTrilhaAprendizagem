<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:MauiAppTrilhaAprendizagem.Views"
       x:Class="MauiAppTrilhaAprendizagem.AppShell">

    <!-- Tela inicial: Login -->
    <ShellContent Title="Login"
                  ContentTemplate="{DataTemplate views:LoginPage}" />

    <!-- Tela de Cadastro -->
    <ShellContent Title="Cadastro"
                  ContentTemplate="{DataTemplate views:CadastroPage}" />

    <!-- Você pode adicionar mais páginas aqui -->
    <ShellContent Route="TrilhaMatematicaPage"
              ContentTemplate="{DataTemplate views:TrilhaMatematicaPage}" />
</Shell>
